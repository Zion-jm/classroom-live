{
  "name": "classroom-quiz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "check:supabase": "node scripts/check-supabase.mjs",
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
